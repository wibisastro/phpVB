    <!-- agendb: endpoint BACA-SAJA DB app untuk pengembang (MCP gov3phpvb, skill phpvb_cek_db) — Gov2lib\agendb.
         Mati tanpa rahasia (PHPVB_AGENDB_SECRET / core/config/agendb.secret); identitas X-Gov3-User → webmaster/superuser.xml. v5.1.4 -->
    <route>
        <method>GET</method>
        <uri>/{app}/agendb</uri>
        <handler>Gov2lib\agendbHandler</handler>
    </route>
    <route>
        <method>GET</method>
        <uri>/{app}/agendb/{cmd}[/{id}]</uri>
        <handler>Gov2lib\agendbHandler</handler>
    </route>
    <route>
        <method>POST</method>
        <uri>/{app}/agendb</uri>
        <handler>Gov2lib\agendbHandler</handler>
    </route>

    <!-- manifest: INDEKS manifest app (daftar MVC bermanifest + endpoint) — Gov2lib\manifest. Manifest itu sendiri milik tiap MVC:
         /{app}/{mvc}/manifest[/readme|/release][/raw] = cmd bawaan semua controller app (dispatcher → Gov2lib\Manifest\Endpoint,
         berkas view/{mvc}/{manifest,readme,release}.md). authenticate('guest') kecuali <manifest>public</manifest>. v5.1.5 → v5.1.7 -->
    <route>
        <method>GET</method>
        <uri>/{app}/manifest</uri>
        <handler>Gov2lib\manifestHandler</handler>
    </route>
    <route>
        <method>GET</method>
        <uri>/{app}/manifest/{cmd}[/{id}]</uri>
        <handler>Gov2lib\manifestHandler</handler>
    </route>

    <!-- agen: pertukaran identitas kancil → sesi portal (POST cmd=sesi) + klaim sesi (cmd=siapa) — Gov2lib\agen, untuk MCP generik phpvb-run.
         Mati tanpa rahasia (PHPVB_AGEN_SECRET / core/config/agen.secret, terpisah dari agendb.secret). v5.1.6 -->
    <route>
        <method>GET</method>
        <uri>/{app}/agen</uri>
        <handler>Gov2lib\agenHandler</handler>
    </route>
    <route>
        <method>GET</method>
        <uri>/{app}/agen/{cmd}[/{id}]</uri>
        <handler>Gov2lib\agenHandler</handler>
    </route>
    <route>
        <method>POST</method>
        <uri>/{app}/agen</uri>
        <handler>Gov2lib\agenHandler</handler>
    </route>
</list>
